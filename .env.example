UNSPLASH_ACCESS_KEY=your_unsplash_access_key
UNSPLASH_SECRET_KEY=your_unsplash_secret_key

# Hindi layer: set to true to publish /hi/** (indexable + in sitemap).
# Default off. See docs/SEO-STRATEGY.md section 2B before enabling.
NEXT_PUBLIC_HINDI_ENABLED=false

# Gemini image generation (blog featured images)
# GEMINI_API_KEY is reused from above.
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_IMAGE_MODEL_FALLBACK=gemini-3-pro-image
GEMINI_TEXT_MODEL=gemini-3.6-flash

# Search Console sitemap monitoring (/api/cron/sitemap, daily via vercel.json)
# Service account must be added to the Search Console property with Owner or
# Full permission. Restricted cannot submit sitemaps.
#   base64 -i search-console-service-account-key.json | tr -d '\n'
SEARCH_CONSOLE_SERVICE_ACCOUNT_BASE64=
SEARCH_CONSOLE_SITE=sc-domain:dsnenterprises.in
# Vercel sends this as `Authorization: Bearer <secret>` on cron invocations.
CRON_SECRET=

# --- Google Ads conversion tracking
# AW-17769294111 is the account's real Google tag and it OWNS the conversion
# actions. The legacy CID-derived AW-3267328717 has no conversion actions
# behind it, so "AW-3267328717/<label>" silently counts nothing. The tag id and
# the labels must come from the same tag.
NEXT_PUBLIC_GOOGLE_ADS_ID=AW-17769294111
# Conversion labels from Google Ads > Goals > Conversions > (action) > Tag setup.
# Value is only the label part after the slash, e.g. AbC-D_efGhIJklmN
NEXT_PUBLIC_ADS_CONTACT_FORM_LABEL=
NEXT_PUBLIC_ADS_PHONE_CALL_LABEL=
NEXT_PUBLIC_ADS_WHATSAPP_LABEL=
NEXT_PUBLIC_ADS_QUOTE_REQUEST_LABEL=
NEXT_PUBLIC_ADS_THANK_YOU_LABEL=
# Which action counts a contact-form lead. One lead must fire exactly one Ads
# conversion, or the account double-counts. Default: contact_form (fires on the
# verified submit response and carries the lead id). Set to thank_you to use the
# /thank-you page action instead, and mark the other one secondary in Ads.
NEXT_PUBLIC_ADS_PRIMARY_LEAD_ACTION=contact_form
# Consent Mode default. `granted` matches the historical behaviour; set
# `denied` when a consent banner is in place so the banner is what grants it.
NEXT_PUBLIC_GA_CONSENT_DEFAULT=granted

# --- treg (https://treg.superdesign.dev) — SEO data for /admin/seo
# One token, ~2,600 catalogued third-party endpoints. Provider keys (DataForSEO,
# Moz, SerpApi) are injected server-side by treg, so none of them live here.
# Calls are metered against the team's prepaid balance — server-only, never
# expose as NEXT_PUBLIC_*.
# Get a token: `treg login` then copy it, or the dashboard (Team → Tokens).
TREG_TOKEN=
# Team slug. Required for an identity token; a per-org token has it baked in.
TREG_ORG=
# Numeric org id, from GET https://treg.superdesign.dev/orgs. Only used to show
# the remaining balance in the admin UI.
TREG_ORG_ID=
